# Discord Bot Credentials (Bot EN)
DISCORD_TOKEN=your_english_bot_token_here
DISCORD_CLIENT_ID=your_english_bot_client_id_here

# Optionnel : ID du serveur Discord pour enregistrer les slash commands instantanément
DEV_GUILD_ID=your_guild_id_here

# Chemin du dossier de données persistantes
# En local : ./data
# Sur Railway (Volume monté sur /data) : /data
DATA_DIR=./data
